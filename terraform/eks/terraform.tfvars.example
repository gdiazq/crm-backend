aws_region  = "us-east-1"
project     = "crm"
environment = "dev"

kubernetes_version = "1.30"

# Node group sizing
node_instance_types = ["t3.large"]
node_min_size       = 2
node_max_size       = 4
node_desired_size   = 2

# IRSA scoping — match the names used by the notifications stack / .env
s3_bucket       = "crm-uploads"
sqs_email_queue = "crm-dev-email"
event_bus_name  = "crm-events"
